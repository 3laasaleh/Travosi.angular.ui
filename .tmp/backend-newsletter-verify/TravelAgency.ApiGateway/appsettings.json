{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "travelagency-api": {
        "ClusterId": "travelagency-api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "travelagency-swagger": {
        "ClusterId": "travelagency-api-cluster",
        "Match": {
          "Path": "/swagger/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "travelagency-api-cluster": {
        "Destinations": {
          "travelagency-api": {
            "Address": "http://localhost:5152/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        }
      }
    }
  }
}
